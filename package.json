{
  "name": "hulldown",
  "productName": "hulldown",
  "version": "1.12.2",
  "description": "AI-Powered desktop app with your WoT statistics.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "postinstall": "node scripts/patch-packager-unzip.mjs && node scripts/ensure-native-deps.mjs",
    "start": "electron-forge start",
    "start:packaged": "out/hulldown-linux-x64/hulldown",
    "package": "node scripts/patch-packager-unzip.mjs && node scripts/ensure-native-deps.mjs && electron-forge package",
    "package:clean": "rm -rf out/hulldown-linux-x64 out-test out/make .tmp \"$HOME/.cache/hulldown/packager-tmp\" /tmp/electron-packager",
    "make": "node scripts/patch-packager-unzip.mjs && node scripts/ensure-native-deps.mjs && electron-forge make",
    "make:deb": "electron-forge make --targets @electron-forge/maker-deb",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "keywords": [],
  "author": "Krzysztof Baranowski",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "echarts": "^6.0.0",
    "electron": "41.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.4.0",
    "release-it": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.2",
    "vue-echarts": "^8.0.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "better-sqlite3": "^12.8.0",
    "electron-squirrel-startup": "^1.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "^0.28.0",
    "@esbuild/linux-x64": "^0.28.0"
  }
}
