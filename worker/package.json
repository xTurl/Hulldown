{
  "name": "hulldown-ai-proxy",
  "private": true,
  "version": "1.0.0",
  "description": "Free built-in AI proxy for Hulldown — forwards battle debrief / weekly coach / tank tips requests to Groq, with per-device and global fair-use rate limiting so the shared free quota isn't exhausted by a single user.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create hulldown-ai-usage",
    "db:migrate:local": "wrangler d1 execute hulldown-ai-usage --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute hulldown-ai-usage --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260706.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
